/* components/message-item/index.wxss */
.message {
  max-width: 70%;
  margin: 40rpx 24rpx;
  position: relative;
  transition: transform 0.3s ease;
}

.message::before {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: inherit;
  transform: rotate(45deg);
}

/* 接收消息样式 */
.message:not(.own-message) {
  align-self: flex-start;
  background: #fff;
  border-radius: 8rpx 24rpx 24rpx 8rpx;
  padding: 20rpx 24rpx;
  box-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.08);
}

.message:not(.own-message)::before {
  left: -6rpx;
  top: 16rpx;
  background: #fff;
}

/* 发送消息样式 */
.own-message {
  align-self: flex-end;
  background: #07c160;
  border-radius: 24rpx 8rpx 8rpx 24rpx;
  padding: 20rpx 24rpx;
  color: white;
  box-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.08);
}

.own-message::before {
  right: -6rpx;
  top: 16rpx;
  background: #07c160;
}

/* 消息图片 */
.msg-image {
  max-width: 400rpx;
  border-radius: 12rpx;
  display: block;
  background: #f5f5f5;
  transition: transform 0.3s;
}

.msg-image:active {
  transform: scale(0.98);
}

.time {
  font-size: 20rpx;
  color: #999;
  position: absolute;
  bottom: -36rpx;
  right: 0;
  white-space: nowrap;
}

.own-message .time {
  color: rgba(255,255,255,0.8);
  left: 0;
  right: auto;
}