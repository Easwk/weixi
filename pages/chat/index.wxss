/* pages/chat/index.wxss */
/* 消息列表容器 */
.message-list {
  height: calc(100vh - 160rpx);
  background: #f5f5f5;
  padding: 24rpx 0;
  box-sizing: border-box;
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: white;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}

input {
  flex: 1;
  height: 80rpx;
  background: #f8f8f8;
  border-radius: 40rpx;
  padding: 0 32rpx;
  margin-right: 24rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

input:focus {
  background: #fff;
  box-shadow: 0 0 0 2rpx #07c160;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 16rpx;
  opacity: 0.8;
  transition: all 0.3s;
}

.icon:active {
  transform: scale(0.9);
  opacity: 1;
}

button {
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: white;
  border-radius: 40rpx;
  padding: 0 40rpx;
  margin-left: 24rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

button:active {
  opacity: 0.9;
  transform: scale(0.98);
}